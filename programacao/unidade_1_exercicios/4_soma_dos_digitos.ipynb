   "source": [
    "i = int(input(\"Qual o número: \"))\n",
    "j = 0\n",
    "resultado = 0\n",
    "while i != 0:\n",
    "    j += i % 10\n",
    "    print(f\"resultado = {j}\")\n",
    "    i  = i // 10\n",
    "    print(f\" i = {i}\")\n"
   ]
